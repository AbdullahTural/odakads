<?xml version="1.0" encoding="utf-8"?>
<!--
  Next.js static export (trailingSlash: true) — klasor/index.html yapisi.
  IIS bu dosyayi wwwroot altinda gorurse derin link + refresh icin default document kullanir.
  ASP.NET Core inprocess hosting'de tum istekler Kestrel'e gider; bu yedek katmandir.
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>

{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=HasanHabibSeydaDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "HasanHabibSeyda.API",
    "Audience": "HasanHabibSeyda.Client",
    "Key": "REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS_LONG_2026",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Resend": {
    "ApiKey": "",
    "From": "Odak Ads Reklam <info@odakadsreklam.com>",
    "To": "info@odakadsreklam.com"
  },
  "Cors": {
    "Origins": [
      "http://localhost:3000",
      "http://localhost:3005"
    ]
  },
  "Database": {
    "AutoMigrate": true,
    "SeedOnStartup": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}

# Production static export build icin
# npm run build:deploy (veya dotnet publish) bu degerleri scripts/build-static.mjs ile zorlar.
# .env.local'daki NEXT_PUBLIC_API_BASE_URL dev icin kalabilir — build script ezmez.

NEXT_PUBLIC_SITE_URL=https://odakadsreklam.com
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_API_BASE_URL=

# SEO fetch (build:static icinde otomatik) — build sirasinda API calisiyorsa:
# BUILD_SEO_API_URL=http://localhost:5085
# API kapali CI: SKIP_SEO_FETCH=true npm run build:deploy

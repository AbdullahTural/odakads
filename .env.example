# =========================================================================
# Odak Ads Reklam - Ortam Degiskenleri
# Bu dosyayi ".env.local" olarak kopyalayip degerleri doldurun.
# =========================================================================

# Sitenin canli adresi (metadata, sitemap, canonical icin)
NEXT_PUBLIC_SITE_URL=https://odakadsreklam.com

# -------------------------------------------------------------------------
# Mock veri modu
# true  = backend olmadan lokal gelistirme (lib/api/mock-data.ts)
# false = gercek API (production build'de ZORUNLU)
# -------------------------------------------------------------------------
NEXT_PUBLIC_USE_MOCK=true

# -------------------------------------------------------------------------
# API base URL (opsiyonel)
# Tek-host production: BOS birak → istekler relatif /api/... yoluna gider.
# Lokal backend: http://localhost:5085  (launchSettings portuna gore)
# -------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=

# -------------------------------------------------------------------------
# Static build sirasinda admin SEO cekmek icin (opsiyonel — API calisiyor olmali)
# BUILD_SEO_API_URL=http://localhost:5085
# SKIP_SEO_FETCH=true  → SEO fetch atla (API kapali CI senaryosu)
# -------------------------------------------------------------------------
# Iletisim formu e-posta ayarlari FRONTEND'DE DEGIL — backend'de:
# backend/src/API/appsettings.json → Resend:{ApiKey,From,To}
# veya production ortam degiskenleri / appsettings.Production.json
# -------------------------------------------------------------------------
